# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ห้าม commit .env)

# รหัสที่ n8n ต้องส่งมาใน header X-API-Key (ตั้งให้ยาวและเดายาก)
API_KEY=change-me

# โมเดล: path ในโปรเจกต์ หรือชื่อบน Hugging Face
EMBEDDING_MODEL=pretrained_models/bge-m3
# auto, cpu, cuda, cuda:0
DEVICE=auto
# ลดลงถ้าเจอ CUDA out of memory
EMBED_BATCH_SIZE=8
EMBED_MAX_TOKENS=512

# ที่เก็บ index (ChromaDB + SQLite)
INDEX_DIR=data/service_index
COLLECTION=drive-docs

MAX_UPLOAD_MB=50
SEARCH_CANDIDATES=100
SEARCH_MIN_SCORE=0.45
MATCHES_PER_DOCUMENT=3

# ห้ามต่อ Hugging Face (ใช้โมเดลในเครื่องเท่านั้น)
HF_HUB_OFFLINE=1
